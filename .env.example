# Copy to .env and adjust. .env is gitignored.
DATABASE_URL=postgres://ase:ase_dev_pw@localhost:5432/ase
PORT=3000
# Shared internal service auth (ase_api_spec.md open item — defaulted to a shared API key).
# Workers and collectors must send: X-API-Key: <this value>
ASE_API_KEY=dev-internal-key
# LLM provider for Stage 1 classification. Uses the opencode CLI (OpenCode Zen API credential).
LLM_MODEL=opencode/deepseek-v4-flash-free
# Path to the opencode binary (default: resolved from PATH).
OPENCODE_BIN=opencode
# Base URL workers use to reach the internal API.
API_BASE_URL=http://localhost:3000
# Base URL of the Scrapling stealth-browser sidecar (POST /scrape).
# `docker compose up scraper` provides it on http://localhost:8410.
SCRAPLING_SERVICE_URL=http://localhost:8410
# ---------------------------------------------------------------------------
# Slack integration (Workstream B) — OPTIONAL. When SLACK_BOT_TOKEN and
# SLACK_APP_TOKEN are both set, the engine boots a Socket-Mode Bolt app that
# pushes Signal Cards, answers `/ase` slash commands + DMs, and renders
# interactive buttons. When unset, all Slack calls degrade to a safe no-op.
# Leave these commented out unless you have a real Slack app.
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_SIGNING_SECRET=
# # Default channel for Slack alert delivery when a rule omits one.
# SLACK_DEFAULT_CHANNEL=#ase-alerts
# # Base URL of the web app for Open signal / View battlecard deep links.
# ASE_WEB_APP_URL=http://localhost:5173
