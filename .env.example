# Copy to .env and adjust. .env is gitignored.
DATABASE_URL=postgres://ase:ase_dev_pw@localhost:5432/ase
PORT=3000
# LLM provider for Stage 1 classification — any OpenAI-compatible
# chat-completions API works (OpenRouter, OpenAI, Groq, local Ollama, ...).
LLM_MODEL=mistralai/mistral-7b-instruct:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Base URL workers use to reach the internal API.
API_BASE_URL=http://localhost:3000
# Base URL of the Scrapling stealth-browser sidecar (POST /scrape).
# `docker compose up scraper` provides it on http://localhost:8410.
SCRAPLING_SERVICE_URL=http://localhost:8410
